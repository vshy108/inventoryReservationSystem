# Copy to .env and fill in values for local development with docker-compose.
# The inventory service reads these vars at startup.

# PostgreSQL connection string (docker-compose exposes postgres on 5433 to avoid conflicts).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/inventory?sslmode=disable

# Redis connection string (docker-compose exposes redis on 6380 to avoid conflicts).
REDIS_URL=redis://localhost:6380
